# LoRA Dataset Studio environment template
#
# Copy this file to .env for source/Docker installs. Portable builds copy it to
# data/.env on first launch. Never commit a populated .env file.

# Provider credentials -------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
VAST_API_KEY=
REDDIT_CLIENT_ID=
CIVITAI_API_KEY=

# Image-engine defaults ------------------------------------------------------
# Precedence: config.json / Settings > process environment > .env > built-ins.
# Engines: klein (local), nanobanana (Gemini), chatgpt (OpenAI/ChatGPT).
LDS_DEFAULT_GENERATION_ENGINE=klein
LDS_ENABLED_GENERATION_ENGINES=klein
LDS_CHATGPT_AUTH=auto
LDS_CHATGPT_SUBSCRIPTION_MODEL=gpt-5.4-mini

# Provider models. The exact value is sent to the provider and recorded in
# generation provenance.
LDS_OPENAI_IMAGE_MODEL=gpt-image-2
LDS_OPENAI_IMAGE_QUALITY=high
LDS_GOOGLE_IMAGE_MODEL=gemini-3-pro-image

# Local services -------------------------------------------------------------
LDS_OLLAMA_URL=http://127.0.0.1:11434
LDS_OLLAMA_VISION_MODEL=huihui_ai/qwen3-vl-abliterated:8b-instruct
LDS_COMFYUI_API_URL=http://127.0.0.1:8188
# Optional absolute path to the ComfyUI application directory.
LDS_COMFYUI_BASE_DIR=

# Runtime controls -----------------------------------------------------------
# These control the process directly rather than acting as editable Settings
# defaults. Launcher/Docker values may override them.
LDS_HOST=127.0.0.1
LDS_PORT=5050
LDS_MAX_GENERATION_REFERENCES=14
LDS_MAX_UPLOAD_MB=2048

# Required by docker-compose.yml because Docker listens on 0.0.0.0.
LDS_ACCESS_TOKEN=

# Optional path overrides (normally leave blank/unset).
# LDS_DATA_DIR=/absolute/path/to/data
# LDS_CONFIG=/absolute/path/to/config.json
# LDS_ENV=/absolute/path/to/.env

# Backward-compatible aliases (deprecated; canonical LDS_* names above win):
# CHATGPT_IMAGE_MODEL=gpt-image-2
# CHATGPT_IMAGE_QUALITY=high
# NANOBANANA_MODEL=gemini-3-pro-image
# VISION_OLLAMA_MODEL=huihui_ai/qwen3-vl-abliterated:8b-instruct
