+          {GALLERY_KINDS.map((k) => (
+            <button key={k.id} type="button"
+              aria-pressed={filters.kind === k.id}
+              onClick={() => setFilter({ kind: k.id })}
+              className={kindBtnClass(filters.kind === k.id)}>
+              {k.label}
+            </button>
+          ))}
+        </div>
+        <button type="button" aria-pressed={filters.liked}
